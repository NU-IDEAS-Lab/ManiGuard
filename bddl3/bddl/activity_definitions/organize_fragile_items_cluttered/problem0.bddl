(define (problem organize_fragile_items_cluttered-0)
    (:domain omnigibson)

    (:objects
        wineglass.n.01_1 wineglass.n.01_2 - wineglass.n.01
        plate.n.04_1 plate.n.04_2 - plate.n.04
        knife.n.01_1 - knife.n.01
        beer_bottle.n.01_1 - beer_bottle.n.01
        countertop.n.01_1 - countertop.n.01
        cabinet.n.01_1 - cabinet.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    
    (:init 
        (ontop wineglass.n.01_1 countertop.n.01_1)
        (ontop wineglass.n.01_2 countertop.n.01_1)
        (ontop plate.n.04_1 countertop.n.01_1)
        (ontop plate.n.04_2 plate.n.04_1)
        (ontop knife.n.01_1 countertop.n.01_1)
        (ontop beer_bottle.n.01_1 countertop.n.01_1)
        (nextto wineglass.n.01_1 plate.n.04_1)
        (nextto knife.n.01_1 wineglass.n.01_2)
        (inroom countertop.n.01_1 kitchen)
        (inroom cabinet.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    
    (:goal 
        (and 
            (forall 
                (?wineglass.n.01 - wineglass.n.01)
                (and
                    (inside ?wineglass.n.01 ?cabinet.n.01_1)
                    (not (broken ?wineglass.n.01))
                )
            )
            (forall 
                (?plate.n.04 - plate.n.04)
                (not (broken ?plate.n.04))
            )
            (not (ontop ?knife.n.01_1 ?floor.n.01_1))
            (not (broken ?beer_bottle.n.01_1))
        )
    )
)
