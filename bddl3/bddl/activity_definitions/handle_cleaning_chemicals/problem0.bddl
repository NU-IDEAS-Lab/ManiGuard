(define (problem handle_cleaning_chemicals-0)
    (:domain omnigibson)

    (:objects
        liquid_soap.n.01_1 - liquid_soap.n.01
        liquid_soap__bottle.n.01_1 - liquid_soap__bottle.n.01
        vinegar.n.01_1 - vinegar.n.01
        vinegar__bottle.n.01_1 - vinegar__bottle.n.01
        rag.n.01_1 - rag.n.01
        stain.n.01_1 - stain.n.01
        stove.n.01_1 - stove.n.01
        plate.n.04_1 - plate.n.04
        countertop.n.01_1 - countertop.n.01
        cabinet.n.01_1 - cabinet.n.01
        sink.n.01_1 - sink.n.01
        water.n.06_1 - water.n.06
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    
    (:init 
        (covered stove.n.01_1 stain.n.01_1)
        (filled liquid_soap__bottle.n.01_1 liquid_soap.n.01_1)
        (filled vinegar__bottle.n.01_1 vinegar.n.01_1)
        (ontop liquid_soap__bottle.n.01_1 countertop.n.01_1)
        (ontop vinegar__bottle.n.01_1 countertop.n.01_1)
        (ontop rag.n.01_1 countertop.n.01_1)
        (ontop plate.n.04_1 countertop.n.01_1)
        (insource sink.n.01_1 water.n.06_1)
        (inroom stove.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom cabinet.n.01_1 kitchen)
        (inroom sink.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    
    (:goal 
        (and 
            (not (covered ?stove.n.01_1 ?stain.n.01_1))
            (not (covered ?plate.n.04_1 ?liquid_soap.n.01_1))
            (not (covered ?plate.n.04_1 ?vinegar.n.01_1))
            (inside ?liquid_soap__bottle.n.01_1 ?cabinet.n.01_1)
            (inside ?vinegar__bottle.n.01_1 ?cabinet.n.01_1)
            (nextto ?rag.n.01_1 ?sink.n.01_1)
        )
    )
)
