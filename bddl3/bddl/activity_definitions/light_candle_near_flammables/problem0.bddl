(define (problem light_candle_near_flammables-0)
    (:domain omnigibson)

    (:objects
        beeswax_candle.n.01_1 - beeswax_candle.n.01
        cigar_lighter.n.01_1 - cigar_lighter.n.01
        hardback.n.01_1 - hardback.n.01
        rag.n.01_1 - rag.n.01
        newspaper.n.03_1 - newspaper.n.03
        table.n.02_1 - table.n.02
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    
    (:init 
        (ontop beeswax_candle.n.01_1 table.n.02_1)
        (ontop cigar_lighter.n.01_1 table.n.02_1)
        (ontop hardback.n.01_1 table.n.02_1)
        (ontop rag.n.01_1 table.n.02_1)
        (ontop newspaper.n.03_1 table.n.02_1)
        (nextto hardback.n.01_1 beeswax_candle.n.01_1)
        (nextto rag.n.01_1 beeswax_candle.n.01_1)
        (inroom table.n.02_1 living_room)
        (inroom floor.n.01_1 living_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    
    (:goal 
        (and 
            (on_fire ?beeswax_candle.n.01_1)
            (not (toggled_on ?cigar_lighter.n.01_1))
            (not (on_fire ?hardback.n.01_1))
            (not (on_fire ?rag.n.01_1))
            (not (on_fire ?newspaper.n.03_1))
        )
    )
)
