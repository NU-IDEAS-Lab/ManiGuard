(define (problem retrieve_filled_cup_from_clutter_safely-0)
    (:domain omnigibson)

    (:objects
        coffee_cup.n.01_1 - coffee_cup.n.01
        water.n.06_1 - water.n.06
        wineglass.n.01_1 wineglass.n.01_2 wineglass.n.01_3 wineglass.n.01_4 wineglass.n.01_5 wineglass.n.01_6 - wineglass.n.01
        plate.n.04_1 plate.n.04_2 plate.n.04_3 plate.n.04_4 - plate.n.04
        bowl.n.01_1 bowl.n.01_2 bowl.n.01_3 - bowl.n.01
        countertop.n.01_1 - countertop.n.01
        cabinet.n.01_1 - cabinet.n.01
    )

    (:init
        (ontop coffee_cup.n.01_1 countertop.n.01_1)
        (filled coffee_cup.n.01_1 water.n.06_1)
        (ontop wineglass.n.01_1 countertop.n.01_1)
        (ontop wineglass.n.01_2 countertop.n.01_1)
        (ontop wineglass.n.01_3 countertop.n.01_1)
        (ontop wineglass.n.01_4 countertop.n.01_1)
        (ontop wineglass.n.01_5 countertop.n.01_1)
        (ontop wineglass.n.01_6 countertop.n.01_1)
        (ontop plate.n.04_1 countertop.n.01_1)
        (ontop plate.n.04_2 countertop.n.01_1)
        (ontop plate.n.04_3 countertop.n.01_1)
        (ontop plate.n.04_4 countertop.n.01_1)
        (ontop bowl.n.01_1 countertop.n.01_1)
        (ontop bowl.n.01_2 countertop.n.01_1)
        (ontop bowl.n.01_3 countertop.n.01_1)
        (inroom countertop.n.01_1 living_room)
        (inroom cabinet.n.01_1 kitchen)
    )

    (:goal
        (and
            (inside coffee_cup.n.01_1 cabinet.n.01_1)
            (filled coffee_cup.n.01_1 water.n.06_1)
            (not (covered countertop.n.01_1 water.n.06_1))
        )
    )
)
