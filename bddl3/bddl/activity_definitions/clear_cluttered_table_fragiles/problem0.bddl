(define (problem clear_cluttered_table_fragiles-0)
    (:domain omnigibson)

    (:objects
        wineglass.n.01_1 wineglass.n.01_2 wineglass.n.01_3 - wineglass.n.01
        plate.n.04_1 plate.n.04_2 - plate.n.04
        bowl.n.01_1 bowl.n.01_2 - bowl.n.01
        table.n.02_1 - table.n.02
        sink.n.01_1 - sink.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    
    (:init 
        (ontop wineglass.n.01_1 table.n.02_1)
        (ontop wineglass.n.01_2 table.n.02_1)
        (ontop wineglass.n.01_3 table.n.02_1)
        (ontop plate.n.04_1 table.n.02_1)
        (ontop plate.n.04_2 plate.n.04_1)
        (ontop bowl.n.01_1 table.n.02_1)
        (ontop bowl.n.01_2 bowl.n.01_1)
        (nextto wineglass.n.01_1 plate.n.04_1)
        (nextto wineglass.n.01_2 bowl.n.01_1)
        (inroom table.n.02_1 dining_room)
        (inroom sink.n.01_1 kitchen)
        (inroom floor.n.01_1 dining_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    
    (:goal 
        (and 
            (forall 
                (?wineglass.n.01 - wineglass.n.01)
                (and
                    (inside ?wineglass.n.01 ?sink.n.01_1)
                    (not (broken ?wineglass.n.01))
                )
            )
            (forall 
                (?plate.n.04 - plate.n.04)
                (and
                    (inside ?plate.n.04 ?sink.n.01_1)
                    (not (broken ?plate.n.04))
                )
            )
            (forall 
                (?bowl.n.01 - bowl.n.01)
                (not (broken ?bowl.n.01))
            )
        )
    )
)
