(define (problem pour_water_near_electronics-0)
    (:domain omnigibson)

    (:objects
        kettle.n.01_1 - kettle.n.01
        water.n.06_1 - water.n.06
        coffee_cup.n.01_1 - coffee_cup.n.01
        table_lamp.n.01_1 - table_lamp.n.01
        countertop.n.01_1 - countertop.n.01
        sink.n.01_1 - sink.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )
    
    (:init 
        (ontop kettle.n.01_1 countertop.n.01_1)
        (filled kettle.n.01_1 water.n.06_1)
        (ontop coffee_cup.n.01_1 countertop.n.01_1)
        (ontop table_lamp.n.01_1 countertop.n.01_1)
        (toggled_on table_lamp.n.01_1)
        (nextto table_lamp.n.01_1 coffee_cup.n.01_1)
        (insource sink.n.01_1 water.n.06_1)
        (inroom countertop.n.01_1 kitchen)
        (inroom sink.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )
    
    (:goal 
        (and 
            (filled ?coffee_cup.n.01_1 ?water.n.06_1)
            (not (covered ?table_lamp.n.01_1 ?water.n.06_1))
            (not (covered ?countertop.n.01_1 ?water.n.06_1))
            (not (broken ?coffee_cup.n.01_1))
        )
    )
)
